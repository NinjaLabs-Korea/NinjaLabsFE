# Vercel 배포용 런타임 설정. 비밀값 없음 (.env.example 참고)
# BE: Railway https://ninjalabsbe-production.up.railway.app
NINJA_DEPLOYMENT_TIER=production
NINJA_RUNTIME_MODE=api
NINJA_APP_ORIGIN=https://ninjalabsfe.vercel.app
NINJA_API_BASE_URL=https://ninjalabsbe-production.up.railway.app
NEXT_PUBLIC_INJECTIVE_EVM_CHAIN_ID=1439
# Required in api mode whenever a chain ID is set (public Injective EVM testnet JSON-RPC).
NEXT_PUBLIC_INJECTIVE_EVM_RPC_URL=https://k8s.testnet.json-rpc.injective.network/
