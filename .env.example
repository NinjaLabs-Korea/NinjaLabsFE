# Frontend runtime configuration. This file intentionally contains no secrets.
# Valid tiers: local, test, staging, production.
NINJA_DEPLOYMENT_TIER=local

# mock is permitted only for local/test; api connects to NinjaLabsBE.
NINJA_RUNTIME_MODE=mock

# Deterministic local/test fixture scenario seed. Required only in mock mode.
NINJA_MOCK_SEED=default
# Exact server-validated browser origin (no path, query, hash, or credentials).
NINJA_APP_ORIGIN=http://localhost:3000


# Backend base URL. Required only in API mode. Next.js also proxies persisted /media/* assets here.
# NINJA_API_BASE_URL=https://api.example.test

# Optional wallet connection. 1776 is Injective EVM mainnet; 1439 is testnet.
NEXT_PUBLIC_INJECTIVE_EVM_CHAIN_ID=1439
# Public JSON-RPC URL. Optional in mock mode; required in api mode whenever a chain ID is set.
# The chain id and the RPC host must belong to the same network - the config loader rejects 1776 with a host that
# contains "testnet" and 1439 with a host that contains "mainnet":
#   1439 (testnet) -> https://k8s.testnet.json-rpc.injective.network/
#   1776 (mainnet) -> https://sentry.evm-rpc.injective.network/
# NEXT_PUBLIC_INJECTIVE_EVM_RPC_URL=https://k8s.testnet.json-rpc.injective.network/
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-public-project-id

# Optional onboarding/auth console diagnostics (browser console, no secrets). Off unless "true".
# NEXT_PUBLIC_ONBOARDING_DEBUG=true
